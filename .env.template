# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# Email delivery — contact form + Get Crew Deals notifications (server only)
# Option 1 (recommended): SMTP through the existing Hostinger mailbox
SMTP_HOST=smtp.hostinger.com
# 465 = SSL/TLS, 587 = STARTTLS
SMTP_PORT=465
# Full mailbox address, e.g. info@tradieforms.com
SMTP_USER=
SMTP_PASS=
# Option 2 (alternative): Resend API key — only used when SMTP_USER/SMTP_PASS are empty
RESEND_API_KEY=
# Sender. Leave empty to send as SMTP_USER. With Hostinger it must be the SMTP_USER mailbox.
EMAIL_FROM=
# Business inbox that receives notifications (defaults to info@tradieforms.com)
EMAIL_TO=info@tradieforms.com

# Internal admin tools (/admin/orders + supplier production PDFs). Comma-separated sign-in emails.
# An account only gets admin once its email is verified — i.e. it has signed in with Google/Apple
# (email + password sign-up does not verify ownership). Leave empty to disable admin access entirely.
ADMIN_EMAILS=

# Extra browser origins allowed to call the API with a signed-in session (comma separated, e.g. a
# second front-end domain). The site's own domain, WEBSITE_URL and the mobile app are already allowed.
TRUSTED_ORIGINS=

# Card payments — eWAY Rapid API, Responsive Shared Page (server only; never exposed to the browser).
# MYeWAY → Settings → API Key. Sandbox keys come from a sandbox account (https://go.eway.io/s/sandbox).
# The Client Side Encryption key is NOT needed: cards are entered on eWAY's hosted page.
EWAY_API_KEY=
EWAY_PASSWORD=
# "sandbox" (test gateway, default) or "production" / "live" (live payments). Must match the key pair above.
# EWAY_API_KEY is the long Rapid API Key, NOT the "epk-…" Public API Key (that one is for Secure Fields).
EWAY_ENVIRONMENT=sandbox
